<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F5FC"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="236dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="208dp"
                    android:scaleType="fitXY"
                    android:src="@mipmap/icon_mine_top_bg" />

                <com.tencent.qcloud.tuikit.timcommon.component.TitleBarLayout
                    android:id="@+id/self_detail_title_bar"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@android:color/transparent" />

                <FrameLayout
                    android:id="@+id/face_url_area"
                    android:layout_width="match_parent"
                    android:layout_height="112dp"
                    android:layout_gravity="top"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="124dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/qch_panel_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        android:layout_marginBottom="24dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/self_detail_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxWidth="230dp"
                                android:maxLines="1"
                                android:textColor="@color/qch_text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/self_gender_male"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_marginStart="6dp"
                                android:gravity="center"
                                android:text="♂"
                                android:textColor="#1C67FF"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/self_gender_female"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_marginStart="4dp"
                                android:gravity="center"
                                android:text="♀"
                                android:textColor="#F238A7"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:visibility="gone" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/self_detail_account"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/qch_text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </FrameLayout>

                <com.tencent.qcloud.tuikit.timcommon.component.gatherimage.ShadeImageView
                    android:id="@+id/self_icon"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="36dp"
                    android:layout_marginTop="106dp"
                    android:background="#FFFFFF"
                    android:padding="1dp"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/modify_user_icon_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginStart="98dp"
                    android:layout_marginTop="134dp"
                    android:background="@drawable/qch_primary_button"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="更换头像"
                    android:textColor="@color/white"
                    android:textSize="13sp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/qch_group_bg"
                android:clipToOutline="true"
                android:orientation="vertical">

                <com.tencent.qcloud.tuikit.timcommon.component.LineControllerView
                    android:id="@+id/modify_nick_name_lv"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    app:canNav="true"
                    app:name="名字" />

                <com.tencent.qcloud.tuikit.timcommon.component.LineControllerView
                    android:id="@+id/modify_account_lv"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    app:isTop="true"
                    app:name="聚畅信号" />

                <LinearLayout
                    android:id="@+id/self_qr_area"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="我的二维码"
                        android:textColor="@color/qch_text_primary"
                        android:textSize="16sp" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:alpha="0.65"
                        android:src="@mipmap/icon_mine_qr_code" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/qch_group_bg"
                android:clipToOutline="true"
                android:orientation="vertical">

                <com.tencent.qcloud.tuikit.timcommon.component.LineControllerView
                    android:id="@+id/modify_gender_lv"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    app:canNav="true"
                    app:name="性别" />
            </LinearLayout>

            <com.tencent.qcloud.tuikit.timcommon.component.LineControllerView
                android:id="@+id/modify_signature_lv"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:visibility="gone"
                app:name="个性签名" />

            <com.tencent.qcloud.tuikit.timcommon.component.LineControllerView
                android:id="@+id/modify_birthday_lv"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:visibility="gone"
                app:name="生日" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
