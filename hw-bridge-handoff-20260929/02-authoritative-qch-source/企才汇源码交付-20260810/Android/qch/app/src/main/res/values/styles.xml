<resources>
    <!-- Base application theme. -->
    <style name="DemoAppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="background">@color/white</item>
        <!-- 给status栏设置透明颜色 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- Customize your theme here. -->
        <item name="actionSheetStyle">@style/ActionSheetStyleiOS7</item>
    </style>


    <!--解决冷启动白屏问题-->
    <style name="SplashTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="loading_dialog" parent="android:style/Theme.Dialog">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>


    <style name="myChooseDialog" parent="@android:style/Theme.Dialog">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.3</item>
    </style>

    <style name="QchProfileRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:drawableRight">@drawable/arrow_right2</item>
        <item name="android:drawablePadding">14dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/qch_text_primary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="QchProfileCardRow" parent="QchProfileRow">
        <item name="android:layout_height">60dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/qch_group_bg</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>

    <style name="QchProfileActionRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/qch_group_bg</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>

    <style name="QchProfileActionLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:textColor">@color/qch_text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="QchDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginLeft">44dp</item>
        <item name="android:background">@color/qch_divider</item>
    </style>

    <style name="QchSettingRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:drawableRight">@drawable/arrow_right2</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/qch_text_primary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="QchSettingCard" parent="QchSettingRow">
        <item name="android:background">@drawable/qch_group_bg</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>

    <style name="QchNotificationRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingRight">6dp</item>
    </style>

    <style name="QchNotificationLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/qch_text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="QchNotificationSummary">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginLeft">12dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">right</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/qch_text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="QchNotificationValue" parent="QchNotificationSummary">
        <item name="android:layout_marginLeft">8dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="QchNotificationSwitch">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_marginLeft">10dp</item>
        <item name="android:button">@null</item>
        <item name="android:showText">false</item>
        <item name="android:switchMinWidth">46dp</item>
        <item name="android:thumb">@drawable/qch_notification_switch_thumb</item>
        <item name="android:track">@drawable/qch_notification_switch_track</item>
    </style>

    <style name="QchNotificationArrow">
        <item name="android:layout_width">16dp</item>
        <item name="android:layout_height">16dp</item>
        <item name="android:layout_marginLeft">8dp</item>
        <item name="android:src">@drawable/qch_arrow_right_small</item>
    </style>

    <style name="QchNotificationDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginLeft">4dp</item>
        <item name="android:background">@color/qch_divider</item>
    </style>
</resources>
