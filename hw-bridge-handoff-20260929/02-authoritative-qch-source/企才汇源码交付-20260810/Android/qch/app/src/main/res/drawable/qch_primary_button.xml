<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape><solid android:color="#B99BEE" /><corners android:radius="8dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#6424DC" /><corners android:radius="8dp" /></shape>
    </item>
    <item>
        <shape><gradient android:angle="0" android:startColor="#9560F5" android:endColor="#7531F5" /><corners android:radius="8dp" /></shape>
    </item>
</selector>
