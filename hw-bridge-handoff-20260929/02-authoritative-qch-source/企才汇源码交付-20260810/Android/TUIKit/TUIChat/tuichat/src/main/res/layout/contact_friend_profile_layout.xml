<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F5FC"
    android:orientation="vertical">

    <com.tencent.qcloud.tuikit.timcommon.component.TitleBarLayout
        android:id="@+id/friend_title_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/qch_profile_header_bg" />

    <FrameLayout
        android:id="@+id/profile_header_area"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@drawable/qch_profile_header_bg">

        <FrameLayout
            android:id="@+id/friend_detail_area"
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="68dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/qch_profile_card_bg"
            android:clipToOutline="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="24dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/friend_nick_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxWidth="260dp"
                    android:singleLine="true"
                    android:textColor="#202124"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="testbo321" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/friend_account_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/contact_account_tag"
                        android:textColor="#969AA5"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/friend_account"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#969AA5"
                        android:textSize="14sp"
                        tools:text="29007" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/friend_signature_tag"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/friend_signature"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />
        </FrameLayout>

        <com.tencent.qcloud.tuikit.timcommon.component.gatherimage.ShadeImageView
            android:id="@+id/friend_icon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="36dp"
            android:layout_marginTop="50dp"
            android:background="#FFFFFF"
            android:padding="1dp"
            android:scaleType="centerCrop" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="98dp"
            android:layout_marginTop="76dp"
            android:background="@drawable/qch_profile_primary_button"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="好友"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:id="@+id/chat_member_section"
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:background="@drawable/qch_profile_card_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="72dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <com.tencent.qcloud.tuikit.timcommon.component.gatherimage.ShadeImageView
                        android:id="@+id/chat_member_avatar"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:scaleType="centerCrop" />

                    <TextView
                        android:id="@+id/chat_member_name"
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="#34363D"
                        android:textSize="13sp"
                        tools:text="张力" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/chat_member_add"
                    android:layout_width="72dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/qch_chat_member_add_bg"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="+"
                        android:textColor="#FFFFFF"
                        android:textSize="31sp" />

                    <TextView
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="添加"
                        android:textColor="#8D929D"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/add_friend_button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/qch_profile_primary_button"
                android:gravity="center"
                android:text="@string/chat_add_friend"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/friend_settings_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/relationship_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/qch_profile_card_bg"
                        android:clipToOutline="true"
                        android:orientation="vertical">

                        <com.tencent.qcloud.tuikit.timcommon.component.LineControllerView
                            android:id="@+id/remark"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            app:canNav="true"
                            app:isBottom="true"
                            app:name="@string/profile_remark" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="来源"
                                android:textColor="#44474F"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxWidth="220dp"
                                android:maxLines="1"
                                android:text="通过搜索添加"
                                android:textColor="#969AA5"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/qch_profile_card_bg"
                        android:clipToOutline="true"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/btn_delete"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:gravity="center_vertical"
                            android:paddingStart="16dp"
                            android:text="@string/profile_delete_friend"
                            android:textColor="#44474F"
                            android:textSize="16sp" />

                        <com.tencent.qcloud.tuikit.timcommon.component.LineControllerView
                            android:id="@+id/blackList"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            app:isTop="true"
                            app:isSwitch="true"
                            app:name="@string/profile_black" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/chat_settings_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.tencent.qcloud.tuikit.timcommon.component.LineControllerView
                        android:id="@+id/chat_search_history"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/qch_profile_card_bg"
                        app:canNav="true"
                        app:name="@string/qch_find_chat_history" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/qch_profile_card_bg"
                        android:clipToOutline="true"
                        android:orientation="vertical">

                        <com.tencent.qcloud.tuikit.timcommon.component.LineControllerView
                            android:id="@+id/msg_rev_opt"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            app:isSwitch="true"
                            app:name="@string/profile_msgrev_opt" />

                        <com.tencent.qcloud.tuikit.timcommon.component.LineControllerView
                            android:id="@+id/chat_to_top"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            app:isSwitch="true"
                            app:name="@string/chat_to_top" />
                    </LinearLayout>

                    <com.tencent.qcloud.tuikit.timcommon.component.LineControllerView
                        android:id="@+id/chat_background"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/qch_profile_card_bg"
                        app:canNav="true"
                        app:name="@string/profile_chat_background" />

                    <com.tencent.qcloud.tuikit.timcommon.component.LineControllerView
                        android:id="@+id/Report"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/qch_profile_card_bg"
                        app:canNav="true"
                        app:name="@string/qch_report" />

                    <TextView
                        android:id="@+id/btn_clear_chat_history"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/qch_profile_card_bg"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:text="@string/profile_clear_message"
                        android:textColor="#44474F"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:id="@+id/extension_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/warning_extension_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/send_message_button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/qch_profile_primary_button"
        android:gravity="center"
        android:text="@string/profile_chat"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
