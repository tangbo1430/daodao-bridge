    <item android:width="10dp" android:height="10dp" android:gravity="top|left" android:left="1dp" android:top="10dp">
        <rotate android:fromDegrees="45" android:pivotX="50%" android:pivotY="50%" android:toDegrees="45">
            <shape android:shape="rectangle"><solid android:color="@color/chat_bubble_self_color_light" /><corners android:radius="2dp" /></shape>
        </rotate>
    </item>
    <item android:left="5dp"><shape android:shape="rectangle"><solid android:color="@color/chat_bubble_self_color_light" /><corners android:radius="7dp" android:topLeftRadius="3dp" /></shape></item>
</layer-list>
