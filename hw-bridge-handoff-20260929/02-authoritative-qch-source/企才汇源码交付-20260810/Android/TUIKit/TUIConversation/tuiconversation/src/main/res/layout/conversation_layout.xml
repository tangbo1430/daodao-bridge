<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="消息"
                android:textColor="#1D1D22"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/conversation_unread_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="#FF3158"
                android:textSize="13sp"
                android:visibility="gone" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/conversation_search"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="搜索"
                android:padding="7dp"
                android:src="@drawable/conversation_qch_search_icon" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/conversation_quick_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/conversation_quick_title"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:text="置顶联系人"
                android:textColor="#777B84"
                android:textSize="13sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:fillViewport="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/conversation_quick_list"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />
            </HorizontalScrollView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/conversation_qch_filter_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/conversation_filter_all"
                android:layout_width="58dp"
                android:layout_height="28dp"
                android:background="@drawable/conversation_qch_filter_selected_bg"
                android:gravity="center"
                android:text="全部"
                android:textColor="#7C35FF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/conversation_filter_unread"
                android:layout_width="58dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="未读"
                android:textColor="#666A73"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/conversation_filter_group"
                android:layout_width="58dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="群聊"
                android:textColor="#666A73"
                android:textSize="14sp" />
        </LinearLayout>

        <com.tencent.qcloud.tuikit.tuiconversation.classicui.widget.ConversationListLayout
            android:id="@+id/conversation_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/conversation_fab"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/conversation_qch_fab_bg"
        android:elevation="8dp"
        android:gravity="center"
        android:text="+"
        android:textColor="#FFFFFF"
        android:textSize="34sp" />
</FrameLayout>
