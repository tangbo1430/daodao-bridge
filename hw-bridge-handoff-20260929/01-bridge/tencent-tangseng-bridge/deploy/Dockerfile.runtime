FROM alpine:3.20 AS media-build
RUN apk add --no-cache build-base pkgconf opencore-amr-dev wget xz
WORKDIR /build
RUN wget -q https://ffmpeg.org/releases/ffmpeg-7.1.5.tar.xz -O ffmpeg.tar.xz \
 && echo 'de668509caf9e35e3cd162473441fdb29538c6d96ed080292b3cf9e6fc5d558f  ffmpeg.tar.xz' | sha256sum -c - \
 && tar -xf ffmpeg.tar.xz --strip-components=1 \
 && ./configure --prefix=/usr/local --disable-everything --disable-autodetect --disable-doc --disable-debug --disable-network --disable-x86asm --enable-small --enable-version3 --enable-libopencore-amrnb --disable-avdevice --disable-postproc --disable-swscale \
 --enable-protocol=file,pipe --enable-demuxer=mov,amr,wav,mp3,ogg,flac,matroska \
 --enable-decoder=aac,aac_fixed,amrnb,amrwb,mp3,mp3float,pcm_s16le,pcm_s24le,pcm_s32le,pcm_f32le,flac,opus,vorbis \
 --enable-parser=aac,aac_latm,mpegaudio,opus --enable-encoder=aac,libopencore_amrnb --enable-muxer=ipod,mov,amr --enable-filter=aresample,aformat,anull \
 && make -j2 >/dev/null && make install >/dev/null \
 && ffmpeg -hide_banner -encoders 2>/dev/null | grep libopencore_amrnb

FROM alpine:3.20
RUN apk add --no-cache ca-certificates opencore-amr libstdc++
COPY --from=media-build /usr/local/bin/ffmpeg /usr/local/bin/ffprobe /usr/local/bin/
COPY bridge /bridge
ENTRYPOINT ["/bridge"]
