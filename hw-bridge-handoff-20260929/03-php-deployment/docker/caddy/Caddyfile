admin.awhaha.com {
	root * /srv/backend/public
	encode zstd gzip
	@adminHtml path /admin/*.html /admin/page/*.html /admin/page/*/*.html
	header @adminHtml Cache-Control "no-store"
	request_header X-Internal-Client-IP {client_ip}
	@home path /
	redir @home /admin/page/login.html
	@thinkphp not file
	rewrite @thinkphp /index.php?s={path}&{query}
	php_fastcgi php:9000 {
		root /var/www/app/public
	}
	file_server
}

